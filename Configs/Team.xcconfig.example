// Copy to Team.xcconfig (gitignored) for Developer ID + notarization + iCloud.
// Find the team id in Xcode → Settings → Accounts → Team.
// iCloud container setup: Configs/iCloud-setup.md
GRIZZYBOT_DEVELOPMENT_TEAM = YOURTEAMID
GRIZZYBOT_CODE_SIGN_IDENTITY = Developer ID Application
GRIZZYBOT_CODE_SIGN_STYLE = Manual
GRIZZYBOT_OTHER_CODE_SIGN_FLAGS = --timestamp
GRIZZYBOT_CODE_SIGN_ENTITLEMENTS = Sources/GrizzyBot/GrizzyBot.Release.entitlements
GRIZZYBOT_ENABLE_HARDENED_RUNTIME = YES

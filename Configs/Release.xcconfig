// Release defaults stay ad-hoc so CI and machines without a Developer ID still build.
// Copy Team.xcconfig.example → Team.xcconfig (gitignored) to notarize with iCloud.
GRIZZYBOT_CODE_SIGN_IDENTITY = -
GRIZZYBOT_CODE_SIGN_STYLE = Automatic
GRIZZYBOT_OTHER_CODE_SIGN_FLAGS = --timestamp=none
GRIZZYBOT_CODE_SIGN_ENTITLEMENTS = Sources/GrizzyBot/GrizzyBot.entitlements
GRIZZYBOT_DEVELOPMENT_TEAM =
SENTRY_DSN =

#include? "Team.xcconfig"

CODE_SIGN_IDENTITY = $(GRIZZYBOT_CODE_SIGN_IDENTITY)
CODE_SIGN_STYLE = $(GRIZZYBOT_CODE_SIGN_STYLE)
OTHER_CODE_SIGN_FLAGS = $(GRIZZYBOT_OTHER_CODE_SIGN_FLAGS)
CODE_SIGN_ENTITLEMENTS = $(GRIZZYBOT_CODE_SIGN_ENTITLEMENTS)
DEVELOPMENT_TEAM = $(GRIZZYBOT_DEVELOPMENT_TEAM)
